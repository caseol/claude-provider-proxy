#!/usr/bin/env bash
# claude-proxy — launch Claude Code against a chosen backend provider.
#
#   claude-proxy <provider> [--profile <name>] [-- <claude args>]
#   claude-proxy profile <provider> {list|use <name>|show [name]|new <name>|edit [name]}
#   claude-proxy daemon {start|stop|status|logs}
#
# The daemon (single FastAPI process) is shared by all providers; the provider is
# selected by the URL path (ANTHROPIC_BASE_URL=http://127.0.0.1:<port>/<provider>).
set -e

PORT="${CLAUDE_PROVIDER_PROXY_PORT:-3460}"
PY="${CLAUDE_PROVIDER_PROXY_PY:-/usr/bin/python3}"
CFG="$HOME/.config/claude-provider-proxy"
PROFILES="$CFG/profiles"
LOG="${CLAUDE_PROVIDER_PROXY_LOG:-/tmp/claude-provider-proxy.log}"

# Resolve repo home (for the daemon): <repo>/bin/this -> <repo>; else env file; else default.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"; DIR="$(dirname "$SELF")"
if [ -d "$DIR/../claude_provider_proxy" ]; then HOME_DIR="$(cd "$DIR/.." && pwd)";
elif [ -f "$CFG/env" ]; then . "$CFG/env"; HOME_DIR="${CLAUDE_PROVIDER_PROXY_HOME:?}";
else HOME_DIR="$HOME/Workspace/claude-provider-proxy"; fi

port_up() { ss -tlnp "sport = :$PORT" 2>/dev/null | grep -q LISTEN; }

# Provider -> short A2A lane name (keeps A2A lanes consistent with the old setup).
lane_of() { case "$1" in opencode-go) echo go;; opencode-zen) echo zen;; nvidia) echo nv;; openrouter) echo or;; groq) echo gq;; gemini) echo gm;; land) echo land;; *) echo "$1";; esac; }
# Provider -> default model for unset slots.
default_model() { case "$1" in
  opencode-go) echo kimi-k2.7-code;;
  opencode-zen) echo deepseek-v4-flash-free;;
  nvidia) echo deepseek-ai/deepseek-v4-flash;;
  openrouter) echo deepseek/deepseek-v4-flash;;
  groq) echo openai/gpt-oss-120b;;
  gemini) echo gemini-2.5-flash;;
  land) echo "";;   # preencha no profile após listar modelos com sua LAND_API_KEY
  *) echo "";; esac; }

# ── daemon control ────────────────────────────────────────────────
daemon() {
  case "${1:-start}" in
    start)
      if port_up; then echo "daemon já no ar (porta $PORT)"; return 0; fi
      mkdir -p "$CFG"
      ( cd "$HOME_DIR" && PYTHONPATH="$HOME_DIR" CLAUDE_PROVIDER_PROXY_PORT="$PORT" \
        nohup "$PY" -m claude_provider_proxy.main >"$LOG" 2>&1 & )
      for _ in $(seq 1 15); do port_up && break; sleep 1; done
      port_up && echo "daemon pronto na porta $PORT" || { echo "falhou:"; tail -15 "$LOG"; return 1; } ;;
    stop)
      pid=$(ss -tlnp "sport = :$PORT" 2>/dev/null | grep -oP 'pid=\K[0-9]+' | head -1)
      [ -n "$pid" ] && kill "$pid" 2>/dev/null && echo "parado ($pid)" || echo "não estava no ar" ;;
    status) port_up && echo "no ar (porta $PORT)" || echo "parado" ;;
    logs) tail -f "$LOG" ;;
    *) echo "uso: claude-proxy daemon {start|stop|status|logs}"; return 1 ;;
  esac
}

# ── profile management ────────────────────────────────────────────
profile_cmd() {
  local provider="$1" action="$2" name="$3"
  [ -z "$provider" ] && { echo "uso: claude-proxy profile <provider> <list|use|show|new>"; exit 1; }
  local pdir="$PROFILES/$provider"; local active="$pdir/active_profile"
  mkdir -p "$pdir"
  case "$action" in
    list)
      local cur=""; [ -f "$active" ] && cur=$(cat "$active")
      local found=false
      for f in "$pdir"/*.env; do [ -f "$f" ] || continue; found=true
        local n; n=$(basename "$f" .env); local mark=""; [ "$n" = "$cur" ] && mark="  << ativo"
        echo "  $n$mark"
        grep -E '^(FABLE|OPUS|SONNET|HAIKU|SUBAGENT)_MODEL=' "$f" | sed 's/^/      /'
      done
      $found || echo "  (sem perfis — crie com: profile $provider new <nome>)"
      [ -n "$cur" ] && echo "  ativo: $cur" || echo "  ativo: (defaults)" ;;
    use)
      [ -z "$name" ] && { echo "uso: profile $provider use <nome|none>"; exit 1; }
      if [ "$name" = none ] || [ "$name" = clear ]; then rm -f "$active"; echo "perfil removido (defaults)"; exit 0; fi
      [ -f "$pdir/$name.env" ] || { echo "perfil '$name' não existe em $pdir"; exit 1; }
      echo "$name" >"$active"; echo "perfil ativo ($provider) -> $name" ;;
    show)
      [ -z "$name" ] && [ -f "$active" ] && name=$(cat "$active")
      [ -z "$name" ] && { echo "sem perfil ativo"; exit 0; }
      [ -f "$pdir/$name.env" ] || { echo "perfil '$name' não existe"; exit 1; }
      echo "# $provider / $name"; cat "$pdir/$name.env" ;;
    new)
      [ -z "$name" ] && { echo "uso: profile $provider new <nome>"; exit 1; }
      local t="$pdir/$name.env"; [ -f "$t" ] && { echo "já existe: $t"; exit 1; }
      local dm; dm=$(default_model "$provider")
      cat >"$t" <<EOF
# perfil $provider/$name — edite os modelos
FABLE_MODEL=$dm
OPUS_MODEL=$dm
SONNET_MODEL=$dm
HAIKU_MODEL=$dm
SUBAGENT_MODEL=$dm
EOF
      echo "criado: $t" ;;
    edit) profile_edit "$provider" "$name" ;;
    *) echo "uso: claude-proxy profile <provider> <list|use|show|new|edit>"; exit 1 ;;
  esac
}

# ── interactive slot editor: pick a slot, list live models from the
#    provider, assign the chosen model id to that slot in the profile ──
profile_edit() {
  local provider="$1" name="$2"
  [ -z "$provider" ] && { echo "uso: claude-proxy profile <provider> edit [nome]"; exit 1; }
  local pdir="$PROFILES/$provider"; local active="$pdir/active_profile"
  mkdir -p "$pdir"

  local dm; dm=$(default_model "$provider")
  scaffold_profile() {
    cat >"$pdir/$1.env" <<EOF
FABLE_MODEL=$dm
OPUS_MODEL=$dm
SONNET_MODEL=$dm
HAIKU_MODEL=$dm
SUBAGENT_MODEL=$dm
EOF
  }

  if [ -z "$name" ] && [ -f "$active" ]; then name=$(cat "$active"); fi
  if [ -z "$name" ]; then
    local names=(); for f in "$pdir"/*.env; do [ -f "$f" ] && names+=("$(basename "$f" .env)"); done
    if [ "${#names[@]}" -gt 0 ]; then
      echo "Perfis existentes em $provider:"
      local i=1; for n in "${names[@]}"; do echo "  $i) $n"; i=$((i+1)); done
      echo "  n) criar novo perfil"
      read -rp "Escolha: " choice
      if [ "$choice" = "n" ]; then
        read -rp "Nome do novo perfil: " name
        [ -z "$name" ] && { echo "nome vazio, abortando"; return 1; }
        scaffold_profile "$name"
      elif [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#names[@]}" ]; then
        name="${names[$((choice-1))]}"
      else
        echo "escolha inválida"; return 1
      fi
    else
      read -rp "Nenhum perfil existe ainda. Nome do novo perfil: " name
      [ -z "$name" ] && { echo "nome vazio, abortando"; return 1; }
      scaffold_profile "$name"
    fi
  fi

  local pf="$pdir/$name.env"
  [ -f "$pf" ] || { echo "perfil '$name' não existe em $pdir"; return 1; }

  port_up || daemon start >/dev/null

  echo "Buscando modelos de '$provider'..."
  local tmpf; tmpf=$(mktemp)
  curl -s "http://127.0.0.1:$PORT/$provider/v1/models" >"$tmpf"
  local model_lines; mapfile -t model_lines < <("$PY" - "$tmpf" <<'PYEOF'
import json, sys
with open(sys.argv[1]) as f:
    try:
        data = json.load(f)
    except Exception:
        sys.exit(0)
for m in data.get("data", []):
    mid = m.get("id")
    if not mid:
        continue
    free = "free" in mid.lower()
    pricing = m.get("pricing")
    if isinstance(pricing, dict):
        try:
            prompt_cost = float(pricing.get("prompt") or 0)
            completion_cost = float(pricing.get("completion") or 0)
            if prompt_cost == 0 and completion_cost == 0:
                free = True
        except (TypeError, ValueError):
            pass
    print(f"{mid}\t{1 if free else 0}")
PYEOF
)
  rm -f "$tmpf"
  if [ "${#model_lines[@]}" -eq 0 ]; then
    echo "não foi possível listar modelos de '$provider' (daemon no ar? chave configurada em ~/.config/claude-provider-proxy/.env?)"
    return 1
  fi
  mapfile -t model_lines < <(printf '%s\n' "${model_lines[@]}" | sort -u -t $'\t' -k1,1)
  local model_ids=(); local -A model_free=()
  local line mid flag
  for line in "${model_lines[@]}"; do
    mid="${line%%$'\t'*}"; flag="${line##*$'\t'}"
    model_ids+=("$mid"); model_free["$mid"]="$flag"
  done

  while true; do
    echo
    echo "Perfil: $provider/$name"
    grep -E '^(FABLE|OPUS|SONNET|HAIKU|SUBAGENT)_MODEL=' "$pf" | sed 's/^/  /'
    echo
    echo "  1) FABLE_MODEL   2) OPUS_MODEL   3) SONNET_MODEL   4) HAIKU_MODEL   5) SUBAGENT_MODEL   0) sair"
    read -rp "Slot a editar: " slot_choice
    local slot=""
    case "$slot_choice" in
      1) slot=FABLE_MODEL ;;
      2) slot=OPUS_MODEL ;;
      3) slot=SONNET_MODEL ;;
      4) slot=HAIKU_MODEL ;;
      5) slot=SUBAGENT_MODEL ;;
      0|"") break ;;
      *) echo "opção inválida"; continue ;;
    esac

    read -rp "Filtrar modelos (vazio = todos, 'free' = só grátis): " filter
    local filter_free=0
    if [ "${filter,,}" = "free" ]; then filter_free=1; filter=""; fi
    local i=1; local filtered=()
    for mid in "${model_ids[@]}"; do
      [ "$filter_free" -eq 1 ] && [ "${model_free[$mid]}" != "1" ] && continue
      if [ -z "$filter" ] || [[ "$mid" == *"$filter"* ]]; then
        local mark=""; [ "${model_free[$mid]}" = "1" ] && mark="  [grátis]"
        filtered+=("$mid"); printf "  %3d) %s%s\n" "$i" "$mid" "$mark"; i=$((i+1))
      fi
    done
    if [ "${#filtered[@]}" -eq 0 ]; then echo "nenhum modelo bate com o filtro"; continue; fi

    read -rp "Modelo (número, vazio p/ cancelar): " midx
    [ -z "$midx" ] && continue
    if ! [[ "$midx" =~ ^[0-9]+$ ]] || [ "$midx" -lt 1 ] || [ "$midx" -gt "${#filtered[@]}" ]; then
      echo "índice inválido"; continue
    fi
    local chosen="${filtered[$((midx-1))]}"
    if grep -q "^${slot}=" "$pf"; then
      sed -i "s|^${slot}=.*|${slot}=${chosen}|" "$pf"
    else
      echo "${slot}=${chosen}" >>"$pf"
    fi
    echo "OK: ${slot} -> ${chosen}"
  done

  echo
  echo "Perfil salvo: $pf"
  if [ -f "$active" ] && [ "$(cat "$active")" = "$name" ]; then
    echo "Este é o perfil ativo — o próximo 'claude-proxy $provider' já usa os novos modelos."
  else
    echo "Ative com: claude-proxy profile $provider use $name"
  fi
}

# ── dispatch ──────────────────────────────────────────────────────
case "${1:-}" in
  ""|-h|--help) sed -n '2,11p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0 ;;
  daemon) shift; daemon "$@"; exit $? ;;
  profile) shift; profile_cmd "$@"; exit $? ;;
esac

PROVIDER="$1"; shift
SELECTED_PROFILE=""
PASSTHRU=()
while [ $# -gt 0 ]; do
  case "$1" in
    --profile=*) SELECTED_PROFILE="${1#--profile=}"; shift ;;
    --profile) SELECTED_PROFILE="$2"; shift 2 ;;
    --) shift; PASSTHRU+=("$@"); break ;;
    *) PASSTHRU+=("$1"); shift ;;
  esac
done

# Resolve profile: --profile > active_profile > defaults
pdir="$PROFILES/$PROVIDER"
[ -z "$SELECTED_PROFILE" ] && [ -f "$pdir/active_profile" ] && SELECTED_PROFILE=$(cat "$pdir/active_profile")
if [ -n "$SELECTED_PROFILE" ]; then
  pf="$pdir/$SELECTED_PROFILE.env"
  [ -f "$pf" ] || { echo "perfil '$SELECTED_PROFILE' não encontrado ($pf)"; exit 1; }
  set -a; . "$pf"; set +a
fi
dm=$(default_model "$PROVIDER")
: "${FABLE_MODEL:=$dm}"; : "${OPUS_MODEL:=$dm}"; : "${SONNET_MODEL:=$dm}"; : "${HAIKU_MODEL:=$dm}"; : "${SUBAGENT_MODEL:=$dm}"

# Ensure the daemon is up
port_up || daemon start >/dev/null

export ANTHROPIC_BASE_URL="http://127.0.0.1:$PORT/$PROVIDER"
export ANTHROPIC_AUTH_TOKEN=unused
export ANTHROPIC_DEFAULT_FABLE_MODEL="$FABLE_MODEL"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$OPUS_MODEL"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$SONNET_MODEL"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$HAIKU_MODEL"
export CLAUDE_CODE_SUBAGENT_MODEL="$SUBAGENT_MODEL"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export AGENT_LANE="$(lane_of "$PROVIDER")"

echo "Claude Code -> claude-proxy ($PORT) -> $PROVIDER${SELECTED_PROFILE:+ [perfil: $SELECTED_PROFILE]}"
echo "Fable: $FABLE_MODEL | Opus: $OPUS_MODEL | Sonnet: $SONNET_MODEL | Haiku: $HAIKU_MODEL"

# A2A integration if installed; else launch claude directly.
if [ -f "$HOME/.local/bin/_a2a_common.sh" ]; then
  source "$HOME/.local/bin/_a2a_common.sh"
else
  exec claude "${PASSTHRU[@]}"
fi
