# Perfil exemplo para o provider land (LiteLLM Proxy da UFRJ).
# Modelos disponíveis na virtual key (obtidos de /v1/models):
#   land, glm-5.2-cloud, kimi-k2.7-code-cloud, minimax-m3-cloud
# Slot mapping (benchmark 2026-08-07):
#   - Fable/Opus: kimi-k2.7-code-cloud (melhor modelo de código, native tool history)
#   - Sonnet:     glm-5.2-cloud         (capaz e mais leve que o kimi)
#   - Haiku:      minimax-m3-cloud      (mais rápido em tarefas simples)
#   - Subagent:   glm-5.2-cloud         (balanceado para tarefas em background)
# Copie para: ~/.config/claude-provider-proxy/profiles/land/default.env

FABLE_MODEL=kimi-k2.7-code-cloud
OPUS_MODEL=kimi-k2.7-code-cloud
SONNET_MODEL=glm-5.2-cloud
HAIKU_MODEL=minimax-m3-cloud
SUBAGENT_MODEL=glm-5.2-cloud
